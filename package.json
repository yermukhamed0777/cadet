{
  "name": "cadet",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:hash": "tsc -b && vite build --mode hash",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:data": "vitest run --config vitest.config.ts tests/data",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "capture:walkthrough": "playwright test --config playwright.config.ts tests/e2e/walkthrough.spec.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run build:hash && npm run verify:build && npm run verify:pwa && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9"
  }
}
