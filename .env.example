# ─── Authentication mode ─────────────────────────────────────────────
# demo       — local demo accounts (data stays on this device)
# production — authentication and data via your backend (VITE_API_URL)
VITE_AUTH_MODE=demo

# Backend API URL (no trailing slash). Required in production mode.
# Example: https://api.example.com
VITE_API_URL=

# Google OAuth — PUBLIC Client ID only.
# Keep the Client Secret on the backend, NEVER in this file.
VITE_GOOGLE_CLIENT_ID=

# Frontend route the backend redirects to after Google OAuth.
VITE_OAUTH_REDIRECT_PATH=/auth/callback
