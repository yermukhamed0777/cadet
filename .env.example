# ─── Режим авторизации ─────────────────────────────────────────────
# demo       — локальные демо-аккаунты (данные только на этом устройстве)
# production — авторизация и данные через ваш backend (VITE_API_URL)
VITE_AUTH_MODE=demo

# URL backend API (без завершающего слэша). Нужен в режиме production.
# Пример: https://api.bolashaq-kursant.kz
VITE_API_URL=

# Google OAuth — ТОЛЬКО публичный Client ID.
# Client Secret храните исключительно на backend, НЕ в этом файле.
VITE_GOOGLE_CLIENT_ID=

# Куда backend вернёт пользователя после Google OAuth (фронтенд-маршрут).
VITE_OAUTH_REDIRECT_PATH=/auth/callback
